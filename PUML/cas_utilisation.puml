@startuml Cas_utilisation_global
' Diagramme de cas d'utilisation global --- Immersio / Tynass IT

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #2B4B6F
skinparam actorStyle awesome
skinparam nodesep 55
skinparam ranksep 100

skinparam actor {
  BackgroundColor #183D5D
  FontColor #000000
  BorderColor #0E2740
}

skinparam usecase {
  BackgroundColor #E8EEF4
  BorderColor #183D5D
  FontColor #000000
}

skinparam rectangle {
  BorderColor #9AAEC3
  FontColor #000000
}

left to right direction

actor "Superadmin" as SA
actor "Staff Admin" as ST
actor "Company" as CO
actor "Employé" as EM

' Superadmin hérite de Staff Admin
SA -|> ST

rectangle "Plateforme Immersio" {

  rectangle "Supervision de la plateforme" as R1 {
    usecase "Gérer les comptes\nStaff Admin" as UC_admins
    usecase "Supprimer entreprises\net formations" as UC_delete
  }

  rectangle "Gestion des clients et du catalogue" as R2 {
    usecase "Gérer les\nentreprises" as UC_comp
    usecase "Gérer le catalogue\nde formations" as UC_train
    usecase "Assigner des\nformations" as UC_assign
  }

  rectangle "Authentification" as R3 {
    usecase "S'authentifier au dashboard" as UC_auth
  }

  rectangle "Parc de casques" as R4 {
    usecase "Activer initialement\nun casque" as UC_activate_device
    usecase "Révoquer\nun casque" as UC_revoke_device
    usecase "Réactiver\nun casque attribué" as UC_reactivate_device
  }

  rectangle "Suivi et statistiques" as R5 {
    usecase "Consulter les statistiques\net sessions" as UC_stats
    usecase "Consulter les\nsessions employés" as UC_sess
  }

  rectangle "Gestion des employés et des parcours" as R6 {
    usecase "Gérer ses\nemployés" as UC_emp
    usecase "Créer / gérer\nles quiz" as UC_quiz
    usecase "Définir des\nobjectifs (milestones)" as UC_mile
  }

  rectangle "Formation immersive (VR)" as R7 {
    usecase "S'authentifier sur un casque\n(code d'accès + PIN)" as UC_login
    usecase "Suivre le\ntutoriel VR" as UC_tuto
    usecase "Suivre une formation VR" as UC_sim
    usecase "Répondre au quiz" as UC_passquiz
    usecase "Consulter ses\nrésultats" as UC_res
  }
}

' --- Liens Superadmin ---
SA -- UC_admins
SA -- UC_delete

' --- Liens Staff Admin ---
ST -- UC_auth
ST -- UC_comp
ST -- UC_train
ST -- UC_activate_device
ST -- UC_revoke_device
ST -- UC_assign
ST -- UC_stats

' --- Liens Company ---
CO -- UC_auth
CO -- UC_emp
CO -- UC_quiz
CO -- UC_mile
CO -- UC_reactivate_device
CO -- UC_revoke_device
CO -- UC_sess

' --- Liens Employé ---
EM -- UC_login
EM -- UC_tuto
EM -- UC_sim
EM -- UC_passquiz
EM -- UC_res

@enduml