@startuml Composants_Unity
' Diagramme de composants --- scripts principaux Unity (Immersio)
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #2B4B6F
skinparam component {
  BackgroundColor #183D5D
  FontColor #FFFFFF
  BorderColor #0E2740
}
skinparam package {
  BackgroundColor #E8EEF4
  BorderColor #183D5D
  FontColor #000000
}

title Composants principaux de l'application Unity

package "Communication et état" {

  [TynassApiClient] as API

  [AppSession] as Session
}

package "Navigation et interfaces" {

  [PanelManager] as Panel

  [EmployeeSignInPanel] as SignIn

  [ModulesPanel] as Modules

  [SettingsPanel] as Settings

  [AboutTynassItPanel] as About
}

package "Activation et tutoriel" {

  [DeviceActivationManager] as Device

  [TrainingSceneManager] as Training
}

API -> Session : lit / écrit l'état global
Device ---> API : vérifier / activer\nle casque
SignIn --> API : authentifier\nl'employé
SignIn --> Session : conserver les informations\nde l'employé
Modules --> API : récupérer\nles formations
Modules --> Session : définir la\nformation active
Panel --> SignIn
Panel --> Modules
Panel -> Settings
Panel -left-> About

note bottom of Session
Conserve les informations liées
au casque, à l'entreprise,
à l'employé et à la formation active.
end note

note bottom of Settings
Les réglages sont
enregistrés localement.
end note

note bottom of Training
Gère les trois leçons
et les narrations du tutoriel.
end note
@enduml
