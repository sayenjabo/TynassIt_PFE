@startuml Diagramme_de_classes
' ============================================================
'  Diagramme de classes --- Principaux modèles MongoDB (Immersio / Tynass IT)
'  Généré à partir des schémas Mongoose réels du backend.
'  Rendu : coller sur https://www.plantuml.com/plantuml
'  puis Export PNG ou SVG.
' ============================================================

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #D6E4F0
skinparam classAttributeFontColor #000000
skinparam classBorderColor #5B7FA6
skinparam ArrowColor #5B7FA6
skinparam shadowing false
skinparam linetype ortho
hide circle

class Company {
  - companyName : String
  - email : String «unique»
  - password : String «bcrypt»
  - assignedTrainings : ObjectId[] «ref Training»
  - isActive : Boolean
  - resetPasswordToken : String
  - resetPasswordExpires : Date
}

class Training {
  - title : String
  - description : String
  - category : String
  - thumbnailUrl : String
  - sceneName : String
  - isActive : Boolean
}

class Employee {
  - company : ObjectId «ref Company»
  - name : String
  - jobTitle : String
  - department : String
  - accessCode : String «XX-001, unique par entreprise»
  - pin : String «bcrypt»
  - isActive : Boolean
}

class Device {
  - metaUserId : String «unique»
  - company : ObjectId «ref, nullable»
  - label : String
  - activationCode : String
  - activationCodeExpires : Date
  - deviceToken : String «hash SHA-256»
  - deviceTokenPlain : String «60s»
  - deviceTokenPlainExpires : Date
  - isActive : Boolean
  - activatedAt : Date
  - revokedAt : Date
}

class Session {
  - company : ObjectId «ref Company»
  - training : ObjectId «ref Training»
  - employee : ObjectId «ref, employee»
  - startedAt : Date
  - completedAt : Date
  - durationSeconds : Number
  - score : Number
  - passed : Boolean
  - attemptNumber : Number
  - notes : String
}

class Quiz {
  - training : ObjectId «ref Training»
  - company : ObjectId «ref Company»
  - passingScore : Number «défaut 70»
  - isActive : Boolean
}

class QuizResult {
  - company : ObjectId «ref Company»
  - training : ObjectId «ref Training»
  - employee : ObjectId «ref Employee»
  - quiz : ObjectId «ref Quiz»
  - score : Number
  - passed : Boolean
  - correctCount : Number
  - totalQuestions : Number
  - passingScore : Number
  - consumed : Boolean
  - sessionId : ObjectId «ref Session, nullable»
}

class SessionCounter {
  - company : ObjectId «ref Company»
  - training : ObjectId «ref Training»
  - employee : ObjectId «ref Employee, nullable»
  - seq : Number
}

class Counter {
  - key : String «employee_<companyId>»
  - seq : Number «atomic $inc»
}

' ---------------- Sous-documents «embedded» ----------------

class Milestone <<embedded>> {
  - title : String
  - description : String
  - type : training | task
  - status : pending | in_progress | completed
  - module : String «nullable»
  - training : ObjectId «ref Training, nullable»
  - score : Number
  - completedAt : Date
}

class EvaluationCriteria <<embedded>> {
  - criteriaName : String
  - passed : Boolean
  - score : Number
  - notes : String
}

class Question <<embedded>> {
  - text : String
  - choices : Choice[]
  - correctIndex : Number
}

class Choice <<embedded>> {
  - text : String
}

' ---------------- Relations (références) ----------------

Company "0..*" ---> "0..*" Training : assignedTrainings
Employee "0..*" -> "1" Company
Device   "0..*" ..> "0..1" Company
Session  "0..*" -> "1" Company
Session  "0..*" --> "1" Training
Session  "0..*" ..> "0..1" Employee
Quiz     "0..*" --> "1" Training
Quiz     "0..*" --> "1" Company
QuizResult "0..*" --> "1" Company
QuizResult "0..*" -> "1" Training
QuizResult "0..*" -> "1" Employee
QuizResult "0..*" -> "1" Quiz
QuizResult ..> Session : sessionId
SessionCounter "0..*" --> "1" Company
SessionCounter "0..*" --> "1" Training
SessionCounter "0..*" ..> "0..1" Employee
' ---------------- Compositions (embedded) ----------------

Employee "1" *-- "0..*" Milestone
Milestone "0..*" .> "0..1" Training : training
Session  "1" *-- "0..*" EvaluationCriteria
Quiz     "1" *-- "1..*" Question
Question "1" *-- "2..4" Choice

@enduml
