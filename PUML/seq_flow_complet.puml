@startuml Sequence_flow_complet
' Flow complet --- tutoriel -> authentification -> simulation
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #2B4B6F
skinparam ParticipantBackgroundColor #183D5D
skinparam ParticipantFontColor #FFFFFF
skinparam ActorBackgroundColor #183D5D
skinparam ActorFontColor #FFFFFF
skinparam SequenceLifeLineBorderColor #2B4B6F

actor "Employé" as Emp
participant "Tutoriel VR" as Tutoriel
participant "Connexion et formations" as Interface
participant "Backend REST" as API
participant "Simulation Indigo" as Indigo


Emp -> Tutoriel : démarrer l'application
activate Tutoriel

Tutoriel -> Tutoriel : suivre les trois leçons

Tutoriel -> Interface : fin ou passage du tutoriel
deactivate Tutoriel

== Connexion ==

activate Interface

Interface -> API : vérifier l'état d'activation du casque
API --> Interface : état d'activation

Emp -> Interface : saisir le code d'accès et le PIN

Interface -> API : authentifier l'employé
API --> Interface : employé authentifié

== Formations ==

Interface -> API : demander les formations disponibles
API --> Interface : formations attribuées à l'entreprise

Emp -> Interface : lancer la formation Indigo\ndepuis sa carte

Interface -> Indigo : charger la simulation
deactivate Interface

activate Indigo
Indigo --> Emp : démarrer la formation
deactivate Indigo

@enduml